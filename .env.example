# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ksavi?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ksavi?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ksavi"
NEXT_PUBLIC_APP_DESCRIPTION="منصة كرة القدم العربية الأولى - مباريات مباشرة، نتائج، ترتيب، توقعات"

# Optional: External Football APIs
API_FOOTBALL_KEY="your-api-football-key"
API_FOOTBALL_HOST="v3.football.api-sports.io"

# Optional: Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Optional: Error Tracking
SENTRY_DSN=""

# Optional: Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional: Email
RESEND_API_KEY=""
EMAIL_FROM="noreply@ksavi.com"

# Optional: Telegram Bot
TELEGRAM_BOT_TOKEN=""
